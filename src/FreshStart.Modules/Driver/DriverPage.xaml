<UserControl x:Class="FreshStart.Modules.Driver.DriverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="RowItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="驱动与备份" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="安装/卸载第三方驱动，或导出驱动包到指定目录；删除前自动导出备份"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="读取驱动" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding LoadCommand}" />
                        <Button Content="导出全部驱动" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ExportCommand}" />
                        <Button Content="取消导出" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding CancelExportCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,14">
                <StackPanel>
                    <TextBlock Text="安装驱动" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="选择 .inf 文件或包含 INF 的目录；可能需要在虚拟机先验证兼容性"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="驱动 INF 文件或目录" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="选择 INF" Style="{StaticResource SmallButton}"
                                    Command="{Binding ChooseInstallFileCommand}" />
                            <Button Content="选择目录" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding ChooseInstallFolderCommand}" />
                            <Button Content="安装" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                    Command="{Binding InstallDriverCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16,4">
                <ListBox ItemsSource="{Binding Drivers}" Height="470" BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource RowItem}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"

                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" Margin="12,0,10,0" />
                                    <Button Grid.Column="2" Content="删除" Style="{StaticResource SmallButton}"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Text="说明：导出使用 pnputil /export-driver，只读取当前驱动包并复制到目标目录，不会安装或修改驱动；导出的 .inf 可通过设备管理器“从磁盘安装”恢复。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
