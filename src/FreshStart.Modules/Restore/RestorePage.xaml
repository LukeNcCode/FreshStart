<UserControl x:Class="FreshStart.Modules.Restore.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource PrimaryTextBrush}"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <StackPanel>
                <TextBlock Text="全局还原" Style="{StaticResource PageTitle}" />
                <TextBlock Text="把 FreshStart 管理的注册表调控项恢复到基准状态；执行前会再次备份"
                           Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding BaselineText}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="还原到基准" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RestoreCommand}" IsEnabled="{Binding HasBaseline}" />
                        <Button Content="用当前状态覆盖基准" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding CreateBaselineCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="覆盖范围" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="• 一键开荒 / 隐私清理 / 界面调优 / 游戏优化中的注册表项" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    <TextBlock Text="• 快速启动、长路径等服务/系统策略值" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    <TextBlock Text="不包含：服务启动类型、计划任务、已卸载 Appx、winget 安装的软件、驱动、清理掉的缓存文件。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="说明：基准在首次正常启动时自动创建；如果安装后已经做过优化，可以手动覆盖基准为当前状态。还原失败会自动回滚到还原前的值。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
