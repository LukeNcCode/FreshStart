<UserControl x:Class="FreshStart.Modules.Presets.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SmallDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="一键开荒" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="四套预设批量应用注册表优化；先备份、再写入，失败自动回滚"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SparkIcon}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        <TextBlock Text="预设说明" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="预设不会删除文件、不修改服务启动类型；所有项目都是注册表值，可在设置页撤销或逐项关闭。"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                            <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                    Background="{DynamicResource AccentTintBrush}">
                                                <TextBlock Text="{Binding Tag}" FontSize="9.5"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="还原" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="应用预设" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsFullyApplied, Converter={StaticResource InverseBoolConverter}}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppliedText}" FontSize="11"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="提示：预设只覆盖 FreshStart 已知的注册表项；如果系统被组策略或安全软件锁定，写入可能被忽略，页面会显示实际状态。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
