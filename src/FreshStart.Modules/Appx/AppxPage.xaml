<UserControl x:Class="FreshStart.Modules.Appx.AppxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SmallDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="FilterItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,5" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppxItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="原生应用" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="管理当前用户的 Appx 包；系统应用需要二次确认，卸载前自动备份"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- 统计 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="可见应用" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />
                    <StackPanel Grid.Column="2" Margin="18,0,0,0">
                        <TextBlock Text="{Binding SystemText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="系统应用" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" />
                    <StackPanel Grid.Column="4" Margin="18,0,0,0">
                        <TextBlock Text="{Binding SelectedText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="已选中" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="5" Background="{DynamicResource DividerBrush}" />
                    <StackPanel Grid.Column="6" Margin="18,0,0,0">
                        <TextBlock Text="{Binding RemovedText}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="已卸载可恢复" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 工具条 -->
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource FilterItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="11.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="190"
                             ToolTip="按包名或发布者搜索" />
                    <Button Content="卸载选中" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                            Command="{Binding UninstallSelectedCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>
            </Grid>

            <!-- 进度 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource BodyText}" />
                        <Button Content="取消" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                                Command="{Binding CancelUninstallCommand}" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,12,0,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBrush}" />
                </StackPanel>
            </Border>

            <!-- 列表 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,4">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,8,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="正在读取 Appx 包…" Style="{StaticResource CaptionText}" />
                    </Border>
                    <ListBox ItemsSource="{Binding Packages}" Height="470" BorderThickness="0"
                             Background="Transparent" ItemContainerStyle="{StaticResource AppxItem}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanRemove}" VerticalAlignment="Center"
                                                  Margin="2,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Publisher}" FontSize="10.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="430" />
                                                <TextBlock Text=" · " FontSize="10.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding VersionText}" FontSize="10.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}" FontSize="9.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Content="{Binding ProtectedActionText}" Style="{StaticResource SmallDangerButton}" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.ForceRemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 已卸载 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                    Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIcon}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="已卸载应用（可恢复）" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="通过重新注册安装目录中的 AppxManifest.xml 恢复；商店应用可能被系统重新安装。"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding Removed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RemovedAtText}" FontSize="10.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="恢复" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="说明：名称取自开始菜单的本地化显示名；框架/资源包、GUID 组件默认不显示，没有开始菜单入口的内部组件归入“内部组件”。卸载 Appx 只影响当前用户，所有操作都先经过 OperationRunner 备份。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
