<UserControl x:Class="FreshStart.Modules.UiTuning.UiTuningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreshStart.Modules.Controls"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SparkIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding AppliedLabel}" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding AppliedText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="10,1,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PendingText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="重启资源管理器" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                Command="{Binding RestartExplorerCommand}"
                                Visibility="{Binding ShowExplorerTools, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="放弃修改" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                Command="{Binding DiscardCommand}" IsEnabled="{Binding IsDirty}" />
                        <Button Content="应用修改" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyCommand}" IsEnabled="{Binding IsDirty}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16,6">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                            <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                    Background="{DynamicResource WarningTintBrush}"
                                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding RestartText}" FontSize="9.5"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CurrentText, StringFormat=当前值：{0}}"
                                                   FontSize="10" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <controls:ToggleSwitch Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                           IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                                           VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{Binding FooterText}"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
