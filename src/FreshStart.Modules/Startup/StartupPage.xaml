<UserControl x:Class="FreshStart.Modules.Startup.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="FilterItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="FilterBg" CornerRadius="8" Padding="12,6" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FilterBg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartupItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImpactBadge" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ImpactRank}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ImpactRank}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="自启动" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="统一管理 Run/RunOnce、启动文件夹、登录计划任务与第三方自动服务；系统服务默认隐藏，修改前自动备份"
                                   Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- 统计卡 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="启动项总数" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" Margin="0,2,0,2" />
                    <StackPanel Grid.Column="2" Margin="18,0,0,0">
                        <TextBlock Text="{Binding EnabledText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="当前启用" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" Margin="0,2,0,2" />
                    <StackPanel Grid.Column="4" Margin="18,0,0,0">
                        <TextBlock Text="{Binding HighImpactText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="高影响（估算）" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="5" Background="{DynamicResource DividerBrush}" Margin="0,2,0,2" />
                    <StackPanel Grid.Column="6" Margin="18,0,0,0">
                        <TextBlock Text="{Binding TaskText}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="登录计划任务" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,0,0,12" />

            <!-- 过滤器 -->
            <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Margin="0,0,0,12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource FilterItem}"
                     Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 加载 -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="正在枚举启动项…" Style="{StaticResource BodyText}"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </Border>

            <!-- 列表 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,4"
                    Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <ListBox ItemsSource="{Binding VisibleEntries}" Height="460"
                         BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource StartupItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="32" Height="32" CornerRadius="9"
                                            Background="{DynamicResource AccentTintBrush}" VerticalAlignment="Top">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              Data="{Binding Kind, Converter={StaticResource StartupKindIconConverter}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                    Background="{DynamicResource WarningTintBrush}"
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="已禁用" FontSize="9.5"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Source}" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <Border Style="{StaticResource ImpactBadge}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Impact}" FontSize="9.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ImpactRank}" Value="2">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ImpactRank}" Value="3">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding ToggleText}" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{Binding DelayText}" Style="{StaticResource SmallButton}"
                                                Margin="6,0,0,0"
                                                Visibility="{Binding CanDelay, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.ToggleDelayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Text="说明：影响程度为启发式估算（注册表低 / 启动文件夹与计划任务中 / 第三方自动服务高），不是 Windows 的精确启动耗时。系统服务默认隐藏；被 FreshStart 禁用的服务会记录在本机，重启后仍可重新启用。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
