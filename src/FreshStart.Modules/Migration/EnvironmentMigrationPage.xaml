<UserControl x:Class="FreshStart.Modules.Migration.EnvironmentMigrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" Margin="40,24,40,56">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ENVIRONMENT CLONER / LAB" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="环境克隆" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
                    <TextBlock Text="把软件、聊天数据和开发工具链封装成可离线释放的克隆包"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="重新扫描" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                    <Button Content="恢复克隆包" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}"
                            MinWidth="142">
                        <TextBlock>
                            <Run Text="生成克隆包 · " />
                            <Run Text="{Binding SelectedText, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,14">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,260,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button Content="选择全部开发环境" Style="{StaticResource SmallButton}"
                            Command="{Binding SelectAllDevelopmentCommand}" Margin="0,0,8,0" />
                    <Button Content="清除选择" Style="{StaticResource SmallButton}"
                            Command="{Binding ClearSelectionCommand}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource WarningTintBrush}" VerticalAlignment="Top">
                        <Path Data="{StaticResource AlertIcon}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.6" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="离线克隆边界" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Text="安装器和开发工具目录会在源机器提取；目标机器无需访问官网。聊天记录只迁移指定数据目录，不包含登录令牌；商业许可证、驱动和机器绑定数据不会迁移。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="克隆包可能包含私人聊天记录和下载文件，请存放在受保护的磁盘或加密容器中。"
                                   FontSize="10.5" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource BodyText}" />
                        <Button Content="取消" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                                Command="{Binding CancelCommand}" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,12,12">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                            <Setter Property="Opacity" Value="0.48" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanSelect}"
                                              AutomationProperties.Name="{Binding Name}"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="5"
                                                    Padding="6,1" Margin="8,1,0,0">
                                                <TextBlock Text="{Binding KindText}" FontSize="9.5"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Version}" Style="{StaticResource CaptionText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding InstallState}" FontSize="10.5"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="28,10,0,0" />
                                <TextBlock Text="{Binding ClonePlanHint}" FontSize="10.5"
                                           TextWrapping="Wrap" Margin="28,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectionState}" FontSize="10.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" MaxHeight="48" Margin="28,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="28,10,0,0">
                                    <Button Content="选择安装器目录" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.ChooseInstallerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="添加数据目录" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ChooseDataDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBlock Text="{Binding InstallerDirectory}" FontSize="9.5"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="28,5,0,0"
                                           Visibility="{Binding HasManualInstaller, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
