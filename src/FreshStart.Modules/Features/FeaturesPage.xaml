<UserControl x:Class="FreshStart.Modules.Features.FeaturesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Windows 可选功能" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="启用或禁用 Windows 内置功能（Hyper-V、WSL、.NET 3.5、OpenSSH、沙盒等）；部分功能需要重启"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <TextBox Width="260" HorizontalAlignment="Right"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="按功能名搜索" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,4" />

                    <ItemsControl ItemsSource="{Binding Features.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Content="切换" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{Binding Features.MoreText}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding Features.LoadMoreCommand}"
                            HorizontalAlignment="Center" Margin="0,14,0,0"
                            Visibility="{Binding Features.HasMore, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="提示：启用/禁用 Windows 功能可能需要管理员权限与几分钟时间；禁用 Hyper-V/WSL/沙盒等会影响已有虚拟机与容器。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
