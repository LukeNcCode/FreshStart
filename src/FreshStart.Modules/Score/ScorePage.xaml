<UserControl x:Class="FreshStart.Modules.Score.ScorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource PrimaryTextBrush}"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">
            <Grid>
                <StackPanel>
                    <TextBlock Text="开荒评分" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="开荒前后各评一次，用透明权重展示变化；只读采集，不自动优化"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="重新评分" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ScanCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="当前得分" Style="{StaticResource CaptionText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TotalText}" FontSize="42" FontWeight="SemiBold" />
                            <TextBlock Text="/ 100" FontSize="14" VerticalAlignment="Bottom" Margin="6,0,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeltaText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="保存 HTML / JSON 报告" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveReportCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16,6">
                <ItemsControl ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ScoreText}" Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource InputBrush}" />
                                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource CaptionText}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
            <TextBlock Text="评分权重：启动 25、自动服务 15、任务 10、磁盘 15、内存 10、隐私 15、软件 10。分数只用于展示，不建议为冲分乱改系统。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
