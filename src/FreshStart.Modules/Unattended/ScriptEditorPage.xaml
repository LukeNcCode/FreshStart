<UserControl x:Class="FreshStart.Modules.Unattended.ScriptEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreshStart.Modules.Controls"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <!-- 通用配置行：标题 + 说明 + 循环切换按钮 -->
        <DataTemplate x:Key="ModeRowTemplate">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" MinWidth="78"
                            Content="{Binding StateText}"
                            IsEnabled="{Binding CanSelect}"
                            Command="{Binding DataContext.CycleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="0,16,0,40">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="工作流配置" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="把各模块配置成一个执行方案；发送后在同一页面查看计划、风险和报告"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="导入方案" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding ImportJobCommand}" />
                    <Button Content="清空记录" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding ClearRecordedCommand}" />
                    <Button Content="导出方案" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding ExportCommand}" />
                    <Button Content="发送到执行" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendToExecutionCommand}" />
                </StackPanel>
            </Grid>

            <!-- ================= 基本信息 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,12">
                <StackPanel>
                    <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="方案名称" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="说明（可选）" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="完成后重启资源管理器" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:ToggleSwitch IsChecked="{Binding RestartExplorer, Mode=TwoWay}"
                                                   Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="右键菜单、任务栏与资源管理器外观设置需要重启后生效"
                                       Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ================= 更新与外观 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Windows 更新与右键菜单" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding UpdateRows}" ItemTemplate="{StaticResource ModeRowTemplate}"
                                  Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding CtxRows}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- ================= Windows 安全 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Windows 安全" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="服务启动类型对安全中心（wscsvc）无效——它是受保护服务。这里用 Defender 接口处理防护开关，安全中心应用可在下方「系统原生应用」里强制卸载"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding DefenderRows}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- ================= 防火墙 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="防火墙" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="修改配置文件状态或添加/删除规则；写入前会备份，失败可回滚"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding FirewallProfileRows}" ItemTemplate="{StaticResource ModeRowTemplate}" />

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,8" />

                    <TextBlock Text="添加规则" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}" ToolTip="规则名称" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding NewRulePort, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="本地端口，例如 443 或 80,443（可留空）" />
                        <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding NewRuleProgram, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="程序路径，可留空" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding RuleDirectionText}" Style="{StaticResource SmallButton}"
                                Command="{Binding CycleRuleDirectionCommand}" />
                        <Button Content="{Binding RuleActionText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                Command="{Binding CycleRuleActionCommand}" />
                        <Button Content="{Binding RuleProtocolText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                Command="{Binding CycleRuleProtocolCommand}" />
                        <Button Content="添加规则" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding AddFirewallRuleCommand}" />
                        <Button Content="刷新规则" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding ReloadFirewallRulesCommand}" />
                    </StackPanel>

                    <Grid Margin="0,10,0,4">
                        <TextBlock Text="现有规则" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <TextBox Width="220" HorizontalAlignment="Right"
                                 Text="{Binding FirewallRuleSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称搜索规则" />
                    </Grid>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FirewallRuleList.Items}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                            <Button Content="{Binding FirewallRuleList.MoreText}" Style="{StaticResource SmallButton}"
                                    Margin="0,10,0,2" HorizontalAlignment="Center"
                                    Command="{Binding FirewallRuleList.LoadMoreCommand}"
                                    Visibility="{Binding FirewallRuleList.HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= Windows 功能 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Windows 可选功能" Style="{StaticResource SectionTitle}" />
                        <TextBox Width="220" HorizontalAlignment="Right"
                                 Text="{Binding FeatureSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按功能名搜索" />
                    </Grid>
                    <TextBlock Text="启用或禁用 Hyper-V、WSL、.NET 3.5、OpenSSH、沙盒等；部分功能需要重启"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FeatureList.Items}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                            <Button Content="{Binding FeatureList.MoreText}" Style="{StaticResource SmallButton}"
                                    Margin="0,10,0,2" HorizontalAlignment="Center"
                                    Command="{Binding FeatureList.LoadMoreCommand}"
                                    Visibility="{Binding FeatureList.HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= 驱动 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="驱动" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="安装 INF 驱动包，或删除第三方驱动包；删除前会导出备份，可回滚"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DriverInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="驱动 INF 文件或包含 INF 的目录" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="选择 INF" Style="{StaticResource SmallButton}"
                                    Command="{Binding ChooseDriverFileCommand}" />
                            <Button Content="选择目录" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding ChooseDriverInstallFolderCommand}" />
                            <Button Content="{Binding DriverInstallText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding ToggleDriverInstallCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,8" />

                    <Grid>
                        <TextBlock Text="已安装的第三方驱动" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <TextBox Width="220" HorizontalAlignment="Right"
                                 Text="{Binding DriverSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="按设备/厂商/INF 搜索" />
                    </Grid>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DriverList.Items}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                            <Button Content="{Binding DriverList.MoreText}" Style="{StaticResource SmallButton}"
                                    Margin="0,10,0,2" HorizontalAlignment="Center"
                                    Command="{Binding DriverList.LoadMoreCommand}"
                                    Visibility="{Binding DriverList.HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= 系统调控 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="系统调控" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="隐私 / 界面 / 游戏 / 系统，等同「一键开荒」里的单项"
                                   Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding TuningRows}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= 服务 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="服务启动类型" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding ServiceSearch, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                 HorizontalAlignment="Right" ToolTip="按名称搜索服务" />
                    </Grid>
                    <TextBlock Text="受系统保护的服务（如 wscsvc、WinDefend）会标注且执行时自动跳过"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ServiceList.Items}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                            <Button Content="{Binding ServiceList.MoreText}" Style="{StaticResource SmallButton}"
                                    Margin="0,10,0,2" HorizontalAlignment="Center"
                                    Command="{Binding ServiceList.LoadMoreCommand}"
                                    Visibility="{Binding ServiceList.HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= 计划任务 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="登录 / 开机计划任务" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding TaskSearch, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                 HorizontalAlignment="Right" ToolTip="按名称搜索计划任务" />
                    </Grid>
                    <TextBlock Text="只包含非 Microsoft 的登录/开机任务"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" />
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding TaskList.Items}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                            <Button Content="{Binding TaskList.MoreText}" Style="{StaticResource SmallButton}"
                                    Margin="0,10,0,2" HorizontalAlignment="Center"
                                    Command="{Binding TaskList.LoadMoreCommand}"
                                    Visibility="{Binding TaskList.HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= 网络与电源 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="网络 DNS 与电源方案" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding AdapterText, StringFormat=适配器：{0}}" FontSize="12.5" />
                            <TextBlock Text="{Binding DnsPresetText, StringFormat=DNS 预设：{0}}"
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="切换适配器" Style="{StaticResource SmallButton}"
                                    Command="{Binding CycleAdapterCommand}" />
                            <Button Content="切换预设" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding CycleDnsPresetCommand}" />
                            <Button Content="{Binding DnsActionText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding ToggleDnsCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding IpModeText, StringFormat=IP 配置：{0}}" FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="切换 DHCP / 静态" Style="{StaticResource SmallButton}"
                                    Command="{Binding CycleIpModeCommand}" />
                            <Button Content="{Binding IpActionText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding ToggleIpCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding IpStatic, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="静态 IP 地址，例如 192.168.1.20" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0"
                                 Text="{Binding IpPrefix, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="子网前缀长度，例如 24" />
                        <TextBox Grid.Column="2" Margin="8,0,0,0"
                                 Text="{Binding IpGateway, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="默认网关，例如 192.168.1.1" />
                    </Grid>
                    <TextBlock Text="静态 IPv4 需填写地址、前缀与网关；记录后按适配器名称匹配，改名时用 InterfaceIndex 回退"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PowerPlanText, StringFormat=电源计划：{0}}" FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="切换计划" Style="{StaticResource SmallButton}"
                                    Command="{Binding CyclePowerPlanCommand}" />
                            <Button Content="{Binding PowerActionText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding TogglePowerCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="支持 WLAN 与以太网：点「切换适配器」逐个选择，可分别为每块网卡记录 DNS 预设"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ================= 清理与驱动 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="系统清理" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="清理不可回滚；执行时会跳过正在使用的文件"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" />
                    <ItemsControl ItemsSource="{Binding CleanupRows}" ItemTemplate="{StaticResource ModeRowTemplate}" />

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,8" />

                    <TextBlock Text="驱动导出" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DriverFolderDisplay}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="选择目录" Style="{StaticResource SmallButton}"
                                    Command="{Binding ChooseDriverFolderCommand}" />
                            <Button Content="{Binding DriverActionText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding ToggleDriverCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 安装 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="安装软件" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="来自内置 winget 清单；安装不可回滚"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" />
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding InstallRows}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= 系统原生应用 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="卸载系统原生应用" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding AppxSearch, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                 HorizontalAlignment="Right" ToolTip="按包名或显示名搜索" />
                    </Grid>
                    <TextBlock Text="清单是 Windows 11 出厂预装的静态列表（不依赖本机是否还在），条目会标注「已安装 / 未检测到」；移除不存在的应用会在执行时自动跳过。第三方 Store 应用与桌面程序请到「原生应用」「软件卸载」页处理"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,4" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding AppxList.Items}" ItemTemplate="{StaticResource ModeRowTemplate}" />
                            <Button Content="{Binding AppxList.MoreText}" Style="{StaticResource SmallButton}"
                                    Margin="0,10,0,2" HorizontalAlignment="Center"
                                    Command="{Binding AppxList.LoadMoreCommand}"
                                    Visibility="{Binding AppxList.HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= 已记录 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="已记录" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding RecordedSummary}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="导出时会按依赖顺序排列：更新 → 服务 → 防火墙 → 功能 → 计划任务 → 右键菜单 → 调控 → DNS → IP → 电源 → 驱动安装 → 驱动删除 → 安装 → 卸载 → Appx → 驱动导出 → 清理 → 彻底移除 Defender（最后）"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,6" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Recorded}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="移除" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.RemoveRecordedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="说明：配置阶段不会修改系统。点「发送到执行」后会生成依赖排序的执行计划；确认风险后再统一执行、逐步快照、失败回滚可回滚部分。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
