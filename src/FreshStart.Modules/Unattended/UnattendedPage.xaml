<UserControl x:Class="FreshStart.Modules.Unattended.UnattendedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="JobItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Root" CornerRadius="10" Background="Transparent" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="0,16,0,40">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="计划与执行" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="查看依赖排序后的计划、风险和跳过项；一次确认、统一备份、单步失败跳过并生成报告"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="24,0,0,0">
                    <Button Content="报告目录" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding OpenReportsFolderCommand}" />
                    <Button Content="导入方案" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ImportJobCommand}" />
                </StackPanel>
            </Grid>

            <!-- ================= 方案 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,12">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="选择方案" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="配置工作流会自动发送到这里；也可以导入旧版方案 JSON，并继续调整步骤"
                                       Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding Jobs.Count, StringFormat={}{0} 个方案}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                             ItemContainerStyle="{StaticResource JobItemStyle}"
                             Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,10" />

                    <TextBlock Text="方案信息（导入后可修改）" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" ToolTip="方案名称" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0"
                                 Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="说明，可留空" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="保存修改" Style="{StaticResource SmallButton}"
                                    Command="{Binding SaveJobEditsCommand}" />
                            <Button Content="另存为" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding SaveJobAsCommand}" />
                            <Button Content="删除" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding RemoveJobCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 执行计划 ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="执行计划" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="步骤按方案顺序执行；默认单步失败会跳过并继续。导入的方案可直接上移 / 下移 / 删除步骤，改完点「另存为」保存"
                                       Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="280"
                                   TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>

                    <Border CornerRadius="8" Padding="10,8" Margin="0,12,0,0"
                            Background="{DynamicResource WarningTintBrush}"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding WarningText}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </Border>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,4" />

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SkipReason}" Style="{StaticResource CaptionText}"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource WarningBrush}"
                                                       Visibility="{Binding Skipped, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center"
                                                Background="{DynamicResource HoverBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource CaptionText}" FontSize="10.5" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="不可回滚" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" MinWidth="52" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Visibility="{Binding Irreversible, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="上移" Style="{StaticResource SmallButton}"
                                                    Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="下移" Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border CornerRadius="8" Padding="10,8" Margin="0,12,0,0"
                            Background="{DynamicResource HoverBrush}"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding NotesText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </Border>

                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,16,0,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBrush}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding CancelButtonText}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanCancel}" Command="{Binding CancelRunCommand}"
                                    ToolTip="当前步骤收尾后停止，已完成的步骤保留，未执行的跳过" />
                            <Button Content="打开报告" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    IsEnabled="{Binding HasReport}" Command="{Binding OpenReportCommand}" />
                            <Button Content="开始执行" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanRun}" Command="{Binding RunJobCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="安全说明：方案只引用 FreshStart 已有的封装（调控项、右键菜单风格、Windows 更新、winget 安装、ARP 卸载、Appx 移除），不执行任意脚本或命令。执行前统一弹一次确认并逐项快照；卸载/安装类步骤不可回滚，页面会标出。报告写入 %AppData%\FreshStart\reports。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
