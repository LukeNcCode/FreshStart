<UserControl x:Class="FreshStart.Modules.Firewall.FirewallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreshStart.Modules.Controls"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="防火墙" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="开关防火墙配置文件、查看与增删规则；所有写操作先备份，可撤销"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="配置文件" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="域网络" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="域/公司环境" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <controls:ToggleSwitch Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                               IsChecked="{Binding DomainEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="专用网络" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="家庭/可信网络" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <controls:ToggleSwitch Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                               IsChecked="{Binding PrivateEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="公用网络" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="公共 Wi-Fi 等不可信网络" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <controls:ToggleSwitch Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                               IsChecked="{Binding PublicEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Button Content="应用防火墙配置" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Command="{Binding ApplyProfilesCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="添加规则" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="方向 / 动作 / 协议 点击切换；端口与程序可留空"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}" ToolTip="规则名称" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding NewRulePort, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="本地端口，例如 443 或 80,443" />
                        <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding NewRuleProgram, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="程序路径，可留空" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding DirectionText}" Style="{StaticResource SmallButton}"
                                Command="{Binding CycleDirectionCommand}" />
                        <Button Content="{Binding ActionText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                Command="{Binding CycleActionCommand}" />
                        <Button Content="{Binding ProtocolText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                Command="{Binding CycleProtocolCommand}" />
                        <Button Content="添加规则" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding AddRuleCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="现有规则" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Width="220" Text="{Binding RuleSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="按名称搜索规则" />
                            <Button Content="搜索" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding RefreshRulesCommand}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Rules.Items}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center"
                                                Background="{DynamicResource HoverBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Profile}" Style="{StaticResource CaptionText}" FontSize="10.5" />
                                        </Border>
                                        <Button Grid.Column="2" Content="删除" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{Binding Rules.MoreText}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding Rules.LoadMoreCommand}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Visibility="{Binding Rules.HasMore, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
