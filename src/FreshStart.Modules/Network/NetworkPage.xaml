<UserControl x:Class="FreshStart.Modules.Network.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lan="clr-namespace:FreshStart.Modules.Lan"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="PillItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,5" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,24,40,0">
            <RadioButton Content="网络" Style="{StaticResource TabPill}" GroupName="NetworkTab"
                         IsChecked="{Binding ShowNetwork, Mode=TwoWay}" />
            <RadioButton Content="局域网互传" Style="{StaticResource TabPill}" GroupName="NetworkTab"
                         IsChecked="{Binding ShowLan, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVisibility}}">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="网络工具" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="切换 IPv4 DNS、配置 IPv4、刷新解析缓存、Ping 连通性；DNS/IP 变更会先备份原配置"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,14,0,10" />

            <!-- 适配器 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="网络适配器" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PillItem}"
                             Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Margin="6,1,0,0"
                                               Opacity="0.7"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAdapter.Description}" FontSize="12"

                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentDnsText, StringFormat=当前 DNS：{0}}"
                                       Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedAdapter.StatusText}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SuccessBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DNS 预设 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="DNS 服务器" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PillItem}"
                             Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,8,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="应用 DNS" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyDnsCommand}" />
                        <Button Content="刷新 DNS 缓存" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding FlushDnsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- IP 配置 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="IPv4 地址" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding CurrentIpText, StringFormat=当前：{0}}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="自动获取（DHCP）或静态 IP；修改前会快照当前配置，失败自动回滚"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,8" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding IpModeText}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleIpModeCommand}" />
                        <TextBlock Text="点击切换 自动 / 静态" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="静态 IP 地址，例如 192.168.1.20" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding IpPrefix, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="子网前缀长度，例如 24" />
                        <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding IpGateway, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="默认网关，例如 192.168.1.1" />
                    </Grid>

                    <Button Content="应用 IP 配置" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Command="{Binding ApplyIpCommand}" />
                </StackPanel>
            </Border>

            <!-- Ping -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="连通性测试" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Ping 目标域名或 IP，只发送 1 个 ICMP 包，超时 3 秒"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="测试" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding PingCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}" />
                        <TextBlock Grid.Column="2" Text="{Binding PingText}" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="12,0,0,0" MinWidth="120"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="说明：DNS 只修改所选适配器的 IPv4 服务器；自动（DHCP）会清空手动 DNS。VPN/代理软件可能在连接时覆盖 DNS，以其设置为准。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
            </ScrollViewer>

            <Border Visibility="{Binding ShowLan, Converter={StaticResource BoolToVisibility}}">
                <lan:LanSharePage DataContext="{Binding Lan}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
