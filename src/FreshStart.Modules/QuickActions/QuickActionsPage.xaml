<UserControl x:Class="FreshStart.Modules.QuickActions.QuickActionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreshStart.Modules.Controls"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <!-- 欢迎卡片 -->
            <Border CornerRadius="26" Padding="32,28" Background="{DynamicResource HeroSurfaceBrush}"
                    BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="1"
                    Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
                        <Ellipse Width="390" Height="390" Fill="{DynamicResource AccentGlowBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,-180,-145,0" />
                        <Ellipse Width="520" Height="420" Fill="{DynamicResource HeroBlueGlowBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,-120,-80,0" />
                        <Ellipse Width="250" Height="250" Stroke="#24FFFFFF" StrokeThickness="1"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,-130,18,0" />
                    </Grid>

                    <StackPanel Grid.Column="0" Margin="0,0,38,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="SYSTEM READINESS / 01" Style="{StaticResource EyebrowText}"
                                       Foreground="{DynamicResource HeroAccentBrush}" />
                            <Border HorizontalAlignment="Right" CornerRadius="12" Padding="10,4"
                                    Background="#12FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <TextBlock Text="LOCAL SESSION" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9" Foreground="{DynamicResource HeroAccentBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="你的 Windows，随时进入状态"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                   FontWeight="SemiBold" LineHeight="42" TextWrapping="Wrap"
                                   Margin="0,12,0,0" Foreground="{DynamicResource HeroTextBrush}" />
                        <TextBlock Text="把刚装好的 Windows 11 调到顺手的状态。所有修改都会先备份，随时可以撤销。"
                                   FontSize="12.5" LineHeight="20" TextWrapping="Wrap" MaxWidth="580"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource HeroMutedTextBrush}"
                                   Margin="0,10,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Border CornerRadius="9" Padding="10,5" Background="#16FFFFFF"
                                    BorderBrush="#32FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="{Binding ElevationText}" FontSize="11" Margin="7,0,0,0"
                                               Foreground="{DynamicResource HeroMutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="9" Padding="10,5" Margin="8,0,0,0"
                                    Background="#16FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ShieldIcon}" Width="11" Height="11"
                                          Stretch="Uniform" Stroke="{DynamicResource HeroAccentBrush}"
                                          StrokeThickness="1.5" VerticalAlignment="Center" />
                                    <TextBlock Text="本机处理 · 不上传数据" FontSize="11"
                                               Margin="7,0,0,0" Foreground="{DynamicResource HeroMutedTextBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Height="1" Background="#1FFFFFFF" Margin="0,22,0,17" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="01 / LOCAL" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{DynamicResource HeroAccentBrush}" />
                                <TextBlock Text="本地执行" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{DynamicResource HeroTextBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="#24FFFFFF" Margin="16,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="02 / RECOVER" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{DynamicResource HeroAccentBrush}" />
                                <TextBlock Text="可回滚写入" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{DynamicResource HeroTextBrush}" />
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Background="#24FFFFFF" Margin="16,0" />
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="03 / AUDIT" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{DynamicResource HeroAccentBrush}" />
                                <TextBlock Text="完整可审计" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{DynamicResource HeroTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="22" Padding="18,17"
                            Background="#0CFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="READINESS" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                           Foreground="{DynamicResource HeroAccentBrush}" />
                                <Ellipse Width="6" Height="6" HorizontalAlignment="Right"
                                         Fill="{DynamicResource SuccessBrush}" />
                            </Grid>
                            <Grid Width="150" Height="150" Margin="0,8,0,0" HorizontalAlignment="Center">
                                <Ellipse Width="132" Height="132" Fill="{DynamicResource HeroBlueGlowBrush}" />
                                <controls:ScoreRing x:Name="ReadinessRing" Value="0"
                                                    Stroke="{DynamicResource HeroAccentBrush}"
                                                    Track="{DynamicResource HeroBorderBrush}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ScoreNumber" Text="0"
                                               AutomationProperties.AutomationId="ReadinessScore"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="42" FontWeight="Bold"
                                               Foreground="{DynamicResource HeroTextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="就绪评分" FontSize="10"
                                               Foreground="{DynamicResource HeroMutedTextBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding ScoreDetail}" FontSize="10.5"
                                       Foreground="{DynamicResource HeroMutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 区块标题 -->
            <Grid Margin="0,32,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="COMMAND DECK / 02" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="快捷操作" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="常用系统工具的直达入口，不修改任何配置"
                               Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                           Grid.Column="1" MaxWidth="390" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,0,0,0"/>
            </Grid>

            <!-- 操作卡片 -->
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource QuickActionCard}"
                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding TooltipText}"
                                AutomationProperties.Name="{Binding Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10"
                                        Background="{DynamicResource IconSurfaceBrush}" VerticalAlignment="Top">
                                    <Path Data="{Binding IconData}" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,1,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                              />
                                    <TextBlock Text="{Binding Description}" FontSize="11" LineHeight="17"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="{StaticResource ChevronRightIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" VerticalAlignment="Center"
                                      Margin="8,0,0,0" Opacity="0.55" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="提示：重启资源管理器会短暂黑屏；注册表编辑器与环境变量属于高级工具，修改前请先备份。"
                       Style="{StaticResource CaptionText}" Margin="0,20,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
