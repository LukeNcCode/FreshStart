<UserControl x:Class="FreshStart.Modules.WindowsUpdate.WindowsUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Windows 更新" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="暂停、关闭或恢复 Windows Update；关闭操作会同时处理服务、策略与计划任务"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- 状态卡 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="7" Padding="9,3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModeText}" Value="已暂停">
                                                <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModeText}" Value="已超长延期">
                                                <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModeText}" Value="已关闭">
                                                <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ModeText}" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModeText}" Value="已暂停">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ModeText}" Value="已超长延期">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ModeText}" Value="已关闭">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="更新状态" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PauseText, StringFormat=暂停截止：{0}}"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" />

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,14" />

                    <ItemsControl ItemsSource="{Binding ServiceStates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="8,1,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StartText}" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="暂停 7 天" Style="{StaticResource SecondaryButton}"
                                Command="{Binding PauseCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Content="超长延期" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding ExtendedPauseCommand}" ToolTip="把注册表暂停截止时间写到 2099-12-31；Windows 可能忽略或自行恢复"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Content="恢复默认" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding RestoreCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Content="彻底关闭" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                Command="{Binding DisableCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>

                    <Border CornerRadius="10" Background="{DynamicResource WarningTintBrush}"
                            Padding="12,10" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource AlertIcon}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" />
                            <TextBlock Grid.Column="1"
                                       Text="暂停 7 天与超长延期只写注册表暂停截止时间，不修改服务；Windows 可能忽略或自行恢复。彻底关闭需要修改受保护服务，部分系统 ACL 会拒绝（SC exit 5），届时请优先使用暂停/超长延期。"
                                       FontSize="11" LineHeight="17" TextWrapping="Wrap" Margin="9,0,0,0"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 更新历史 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ClockIcon}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                                <TextBlock Text="更新历史" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="读取 Windows Update 的最近 20 条安装记录；首次加载可能需要几秒"
                                       Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Content="加载历史" Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadHistoryCommand}" HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding IsLoadingHistory, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,10" />

                    <TextBlock Text="正在读取更新历史…" Style="{StaticResource CaptionText}"
                               Visibility="{Binding IsLoadingHistory, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="暂无更新历史记录。"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsHistoryLoaded}" Value="True" />
                                            <Condition Binding="{Binding HasHistory}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding HistoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Date}" FontSize="10.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="5" Padding="6,1"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultCode}" Value="4">
                                                            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultCode}" Value="5">
                                                            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ResultText}" FontSize="9.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ResultCode}" Value="4">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ResultCode}" Value="5">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
