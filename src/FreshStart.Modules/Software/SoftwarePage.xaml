<UserControl x:Class="FreshStart.Modules.Software.SoftwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SmallDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <!-- 页头 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="推荐软件" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="装完系统先补这 7 个常用软件。winget 可用时静默安装；缺失时按需在线更新，也可导入微软官方离线包。"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="一键安装全部" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding InstallAllMissingCommand}"
                            IsEnabled="{Binding CanInstallSoftware}"
                            ToolTip="安装清单里所有未安装的软件（单个失败会继续，已成功的保留）" />
                    <Button Content="修复 winget" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding RepairWingetCommand}"
                            ToolTip="重置并更新 winget 源、清理安装缓存；适用于安装器连续 0xC0000005 的情况" />
                    <Button Content="更新源索引" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding UpdateSourceIndexCommand}"
                            ToolTip="刷新 winget 源索引；索引滞后会导致「源里找不到该包」（0x8A150014）" />
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,14,0,10" />

            <!-- winget 需要安装/更新 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                    Visibility="{Binding ShowWingetSetup, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="winget 需要安装或更新" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding WingetVersionText, StringFormat=当前版本：v{0}。FreshStart 不会在启动时强制更新 winget；可联网安装微软官方 App Installer，或在离线环境导入预先下载的安装包。}"
                               Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="在线安装 / 更新 winget" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallWingetCommand}"
                                IsEnabled="{Binding IsWingetInstalling, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Content="打开 Microsoft Store" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding OpenAppInstallerStoreCommand}" />
                        <Button Content="导入离线包" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding InstallWingetFromFileCommand}" />
                        <Button Content="取消下载" Style="{StaticResource SmallDangerButton}" Margin="8,0,0,0"
                                Command="{Binding CancelWingetInstallCommand}"
                                Visibility="{Binding IsWingetInstalling, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{Binding IsWingetCancelling, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding WingetInstallText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 安装进度 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource BodyText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="{Binding CancelButtonText}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                                Command="{Binding CancelInstallCommand}"
                                IsEnabled="{Binding CanCancel}" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,12,0,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBrush}" />
                </StackPanel>
            </Border>

            <!-- 失败重试 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                        Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="上一批有软件安装失败" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <Button Content="重试失败项" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                        Command="{Binding RetryFailedCommand}" />
            </StackPanel>

            <!-- 软件卡片网格 -->
            <ItemsControl ItemsSource="{Binding Packages}" Margin="0,2,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="124" Margin="0,0,12,12" Padding="14"
                                Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                            Background="{DynamicResource AccentTintBrush}">
                                        <TextBlock Text="{Binding Category}" FontSize="9.5"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <Border CornerRadius="5" Padding="6,1" Margin="6,0,0,0"
                                            Background="{DynamicResource AccentTintBrush}"
                                            ToolTip="winget 安装失败时会自动改用厂商官方安装包"
                                            Visibility="{Binding HasDirectFallback, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="直链兜底" FontSize="9.5"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10.5" Margin="0,8,0,0"
                                           TextWrapping="Wrap" MaxHeight="42"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <Grid Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="9.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding InstallState}" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InstallState}" Value="已安装">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="{Binding UpdateText}" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.UpgradeSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="保留现有配置就地升级；升级前建议先退出正在运行的软件"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="安装" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.InstallSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.CanInstallSoftware, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 自定义来源 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CodeIcon}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="自定义来源" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="清单之外的软件可以填 winget ID（用 winget search 查），会作为卡片加入本页"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomId, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="winget ID，例如 Tencent.QQ.NT" />
                        <TextBox Grid.Column="1" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0,0,0" ToolTip="显示名称" />
                        <Button Grid.Column="2" Content="添加" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding AddCustomCommand}" />
                    </Grid>

                    <TextBlock Text="自定义安装路径（可选）" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                    <TextBlock Text="仅对支持 --location 的安装器生效（MSI / Inno Setup / ZIP 等）；留空则用安装器默认目录。走官方直链兜底时不适用。"
                               Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding InstallLocation, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 D:\Apps（留空 = 安装器默认目录）" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding BrowseInstallLocationCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="说明：安装默认走 winget --silent；标「直链兜底」的软件（Chrome / 7-Zip / Everything / Bandizip / PotPlayer）在 winget 失败时会自动改用厂商官方安装包（HTTPS 下载 + 登记好的静默参数 + 装完按已安装列表确认）。单个失败会记录并继续，已成功的保留。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
