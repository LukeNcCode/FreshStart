<UserControl x:Class="FreshStart.Modules.Defender.DefenderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreshStart.Modules.Controls"
             xmlns:firewall="clr-namespace:FreshStart.Modules.Firewall"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SmallDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,24,40,0">
            <RadioButton Content="Defender" Style="{StaticResource TabPill}" GroupName="SecurityTab"
                         IsChecked="{Binding ShowDefender, Mode=TwoWay}" />
            <RadioButton Content="防火墙" Style="{StaticResource TabPill}" GroupName="SecurityTab"
                         IsChecked="{Binding ShowFirewall, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowDefender, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Defender" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="实时防护、云保护、篡改保护与排除项；数据来自 Defender 引擎（WinDefend）"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- 安全中心已移除提示 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0"
                    Visibility="{Binding SecurityCenterRemoved, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AlertIcon}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="Windows 安全中心应用已移除" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Defender 引擎（WinDefend）与安全中心 UI 是两套独立组件，因此本页仍能读取和修改实时防护。FreshStart 不会绕过篡改保护去停用 Defender；这里只负责清理托盘入口（SecurityHealthSystray 的登录自启动项），移除托盘不会关闭 Defender 的扫描与实时防护。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="移除托盘图标" Style="{StaticResource SmallDangerButton}"
                                Command="{Binding RemoveTrayCommand}"
                                IsEnabled="{Binding IsElevated}"
                                Visibility="{Binding ShowTrayCleanup, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding TrayStateText}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 状态与开关 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10"
                                    Background="{DynamicResource AccentTintBrush}" VerticalAlignment="Center">
                                <Path Data="{StaticResource ShieldIcon}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Microsoft Defender" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TamperProtected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="篡改保护：未开启" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TamperProtected}" Value="True">
                                                <Setter Property="Text" Value="篡改保护：已开启（只读）" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,4" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="实时防护" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="关闭后实时拦截停止；篡改保护开启时 Windows 通常会拒绝修改"
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <controls:ToggleSwitch Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                               IsChecked="{Binding RealTimeEnabled, Mode=TwoWay}"
                                               IsEnabled="{Binding CanModify}"
                                               AutomationProperties.Name="实时防护"
                                               VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="云保护" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="MAPSReporting：把可疑文件信息发送到云端进行判定"
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <controls:ToggleSwitch Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                               IsChecked="{Binding CloudEnabled, Mode=TwoWay}"
                                               IsEnabled="{Binding CanModify}"
                                               AutomationProperties.Name="云保护"
                                               VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="防病毒引擎" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="AntivirusEnabled 状态，只读"
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="已禁用" />
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AntivirusEnabled}" Value="True">
                                            <Setter Property="Text" Value="运行中" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="临时关闭 15 分钟" Style="{StaticResource SmallDangerButton}"
                                Command="{Binding TempDisableCommand}"
                                IsEnabled="{Binding CanModify}" />
                        <Button Content="打开 Windows 安全中心" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding OpenSecurityCenterCommand}" />
                    </StackPanel>

                    <Border CornerRadius="10" Background="{DynamicResource WarningTintBrush}" Padding="12,10" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource AlertIcon}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" />
                            <TextBlock Grid.Column="1"
                                       Text="Defender 的实时防护受 Windows 篡改保护控制。若开关失败，请在 Windows 安全中心手动操作；本工具不会绕过系统保护。"
                                       FontSize="11" LineHeight="17" TextWrapping="Wrap" Margin="9,0,0,0"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 排除项 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIcon}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="排除项" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="被排除的路径、进程或扩展名不会被 Defender 扫描。添加前请确认来源可信。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="排除项内容" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="添加路径" Style="{StaticResource SmallButton}"
                                    Command="{Binding AddExclusionCommand}" CommandParameter="Path" />
                            <Button Content="添加进程" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding AddExclusionCommand}" CommandParameter="Process" />
                            <Button Content="添加扩展名" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding AddExclusionCommand}" CommandParameter="Extension" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,4" />

                    <TextBlock Text="暂无排除项" Style="{StaticResource CaptionText}"
                               Visibility="{Binding HasExclusions, Converter={StaticResource InverseBoolToVisibility}}"
                               Margin="0,8,0,0" />

                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="5" Padding="6,1"
                                                Background="{DynamicResource InputBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindText}" FontSize="9.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                   Margin="9,0,8,0" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Value}" />
                                        <Button Grid.Column="2" Content="移除" Style="{StaticResource SmallDangerButton}"
                                                Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 彻底移除 Defender 引擎 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                    Visibility="{Binding ShowRemovalForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AlertIcon}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="彻底移除 Defender 引擎（不可回滚）" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="按 windows-defender-remover 13 的范围执行：移除 Defender 服务/驱动、安全中心、SmartScreen、WebThreat、VBS/凭据保护、驱动阻止列表、系统缓解、计划任务、启动项、右键菜单、策略和安装目录，然后要求重启。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0" />
                    <Border CornerRadius="10" Background="{DynamicResource DangerTintBrush}" Padding="12,10" Margin="0,12,0,0">
                        <TextBlock Text="不可自动回滚。会降低系统安全防护，可能导致 WSL2 / Hyper-V / Windows 沙盒不可用、Windows 更新或商店组件需要修复。建议先创建系统还原点，并确认本机不需要这些功能。"
                                   FontSize="11" LineHeight="17" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Border>

                    <CheckBox Content="我已了解风险，确认彻底移除 Defender 引擎" Margin="0,12,0,0"
                              IsChecked="{Binding AcceptRemovalRisk}" />

                    <Button Content="彻底移除（不可回滚）" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding RemoveEngineCommand}"
                            IsEnabled="{Binding CanRemoveEngine}" />

                    <ProgressBar Height="6" Minimum="0" Maximum="100" Margin="0,12,0,0"
                                 Value="{Binding RemovalProgress}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding RemovalStatusText}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ShowRemovalResult, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="说明：临时关闭会在 15 分钟后通过计划任务自动恢复实时防护；如果计划任务被系统移除，请立即到 Windows 安全中心重新开启。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
            </ScrollViewer>

            <Border Visibility="{Binding ShowFirewall, Converter={StaticResource BoolToVisibility}}">
                <firewall:FirewallPage DataContext="{Binding Firewall}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
