<UserControl x:Class="FreshStart.Modules.ContextMenu.ContextMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cm="clr-namespace:FreshStart.Services.ContextMenu;assembly=FreshStart.Services"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SmallDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="MenuTabControl" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="3"
                                    HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBg" CornerRadius="7" Padding="12,6" Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MenuEntryTemplate" DataType="{x:Type cm:ContextMenuEntry}">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTintBrush}"
                            VerticalAlignment="Top">
                        <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                            <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                    Background="{DynamicResource WarningTintBrush}"
                                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="已禁用" FontSize="9.5" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Source}" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Scope}" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding ToggleText}" Style="{StaticResource SmallButton}"
                                Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.ToggleVerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="移除" Style="{StaticResource SmallDangerButton}" Margin="6,0,0,0"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShellExtensionTemplate" DataType="{x:Type cm:ContextMenuEntry}">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentTintBrush}"
                            VerticalAlignment="Top">
                        <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                            <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                    Background="{DynamicResource WarningTintBrush}"
                                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="已禁用" FontSize="9.5" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                        <TextBlock Text="{Binding Source}" FontSize="10" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding ToggleText}" Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.ToggleHandlerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="移除" Style="{StaticResource SmallDangerButton}" Margin="6,0,0,0"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TrashTemplate" DataType="{x:Type cm:QuarantineEntry}">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource DangerTintBrush}"
                            VerticalAlignment="Top">
                        <Path Data="{StaticResource AlertIcon}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KindText}" FontSize="10.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding OriginalDisplay}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DeletedAtText}" FontSize="10" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="恢复" Style="{StaticResource SmallButton}"
                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <Grid>
                <StackPanel>
                    <TextBlock Text="右键菜单" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="管理经典菜单、Shell 扩展、发送到与新建菜单；每次修改都会先备份"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" MinWidth="72" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionText}" Margin="0,16,0,16" />

            <!-- 风格切换 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SunIcon}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" />
                            <TextBlock Text="菜单风格" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                            <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                    Background="{DynamicResource AccentTintBrush}">
                                <TextBlock Text="当前用户" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StyleStatus}" FontSize="13" Margin="0,10,0,0" />
                        <TextBlock Text="Win11 新版紧凑菜单 ↔ Win10 经典菜单。切换后需要重启资源管理器；只影响当前用户，可随时切回。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Win10 经典" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SwitchToClassicCommand}"
                                IsEnabled="{Binding IsClassicStyle, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Content="Win11 新版" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding SwitchToWin11Command}"
                                IsEnabled="{Binding IsClassicStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 加载状态 -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="正在扫描注册表菜单项…" Style="{StaticResource BodyText}"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </Border>

            <TabControl x:Name="MenuTabs" Style="{StaticResource MenuTabControl}"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <TabItem Header="经典菜单" Style="{StaticResource MenuTabItem}">
                    <StackPanel>
                        <TextBlock Text="注册表 shell 动词（如“在此处打开终端”）。禁用通过 LegacyDisable 实现，不删除原注册表数据。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ShellVerbs}"
                                          ItemTemplate="{StaticResource MenuEntryTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Shell 扩展" Style="{StaticResource MenuTabItem}">
                    <StackPanel>
                        <TextBlock Text="ContextMenuHandlers：第三方扩展（如压缩、网盘）。禁用会把键改名为 -名称，数据保留在原位置。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ShellExtensions}"
                                          ItemTemplate="{StaticResource ShellExtensionTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                </TabItem>

                <TabItem Header="发送到" Style="{StaticResource MenuTabItem}">
                    <StackPanel>
                        <TextBlock Text="“发送到”菜单中的快捷方式。移除后会进入 FreshStart 回收站，可随时恢复。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SendToItems}"
                                          ItemTemplate="{StaticResource MenuEntryTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                </TabItem>

                <TabItem Header="新建" Style="{StaticResource MenuTabItem}">
                    <StackPanel>
                        <TextBlock Text="资源管理器“新建”子菜单中的文件类型（ShellNew）。移除后可从回收站恢复。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding NewMenuItems}"
                                          ItemTemplate="{StaticResource MenuEntryTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                </TabItem>

                <TabItem Header="回收站" Style="{StaticResource MenuTabItem}">
                    <StackPanel>
                        <TextBlock Text="从本页移除的菜单项会保存在这里，数据不销毁；选择“恢复”移回原位置。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TrashItems}"
                                          ItemTemplate="{StaticResource TrashTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <TextBlock Text="说明：Win11 紧凑菜单里的打包应用入口（如系统压缩、照片）由 AppX/COM 注册，不在注册表 shell 列表中；本页管理经典注册表项，风格切换使用上方卡片。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
