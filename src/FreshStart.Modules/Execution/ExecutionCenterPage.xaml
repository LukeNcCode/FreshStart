<UserControl x:Class="FreshStart.Modules.Execution.ExecutionCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style x:Key="TemplateButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="40,22,40,14">
            <StackPanel>
                <TextBlock Text="AUTOMATION CONSOLE / 09" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="执行中心" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
                <TextBlock Text="配置目标工作流，检查执行计划后统一运行；兼容旧方案 JSON 与 --unattended 命令行"
                           Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0"
                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="40,0,40,10"
                Style="{StaticResource CardStyle}" Padding="18,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="START WITH" FontFamily="{StaticResource DisplayFont}"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="2,0,14,6" />
                    <Button Style="{StaticResource TemplateButton}" Command="{Binding NewBlankCommand}">
                        <TextBlock Text="空白工作流 · 0 步" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource TemplateButton}" Command="{Binding UseMinimalTemplateCommand}">
                        <TextBlock Text="清爽新机 · 10 步" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource TemplateButton}" Command="{Binding UsePrivacyTemplateCommand}">
                        <TextBlock Text="隐私优先 · 5 步" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource TemplateButton}" Command="{Binding UseDeveloperTemplateCommand}">
                        <TextBlock Text="开发环境 · 10 步" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource TemplateButton}" Command="{Binding UseGamingTemplateCommand}">
                        <TextBlock Text="游戏优先 · 7 步" FontSize="12" />
                    </Button>
                </WrapPanel>
                <TextBlock Text="模板只生成起始步骤，执行前仍需检查计划与风险"
                           Style="{StaticResource CaptionText}"
                           Margin="2,2,0,0" Grid.Row="1" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Margin="32,0,32,8">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,9" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="Root" CornerRadius="9" Padding="{TemplateBinding Padding}"
                                        Background="Transparent">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Root" Property="Background"
                                                Value="{DynamicResource SelectedTintBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="01  配置工作流">
                <ContentControl Content="{Binding Builder}" />
            </TabItem>
            <TabItem Header="02  计划与执行">
                <ContentControl Content="{Binding Runner}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
