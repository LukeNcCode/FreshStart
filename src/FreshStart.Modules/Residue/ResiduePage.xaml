<UserControl x:Class="FreshStart.Modules.Residue.ResiduePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource PrimaryTextBrush}"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="RowItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">
            <Grid>
                <StackPanel>
                    <TextBlock Text="卸载残留" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="扫描已卸载程序的安装目录、快捷方式、卸载键与服务；文件进隔离区"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="扫描残留" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,14">
                <StackPanel>
                    <TextBlock Text="已卸载程序" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                             Height="90" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Padding="0,4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16,4"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,8,0,4">
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionText}" />
                        <Button Content="清理选中" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Command="{Binding CleanCommand}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Items}" Height="420" BorderThickness="0"
                             Background="Transparent" ItemContainerStyle="{StaticResource RowItem}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanClean}" VerticalAlignment="Center"
                                                  Margin="2,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Kind}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RiskText}" FontSize="9.5" Margin="8,2,0,0"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Evidence}" Style="{StaticResource CaptionText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Text="说明：清理文件会移动到 %AppData%\FreshStart\quarantine；注册表键会先快照再删除，报告保存在 reports。服务仅标记为危险项，不会自动删除。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
