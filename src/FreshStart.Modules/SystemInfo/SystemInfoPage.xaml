<UserControl x:Class="FreshStart.Modules.SystemInfo.SystemInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="40,30,40,56">

            <!-- 页头 -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="系统信息" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="本机硬件、系统版本与激活状态，只读，不会修改任何设置"
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" MinWidth="72"/>
                    <Button Content="复制全部" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CopyAllCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 状态行 -->
            <StackPanel Orientation="Horizontal" Margin="0,18,0,20">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 骨架屏：数据未到时先占位，避免白屏跳动 -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Width="96" Height="14" CornerRadius="7" Background="{DynamicResource SkeletonBrush}" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,20,0,0" Width="520" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,14,0,0" Width="600" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,14,0,0" Width="440" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,14,0,0" Width="560" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Width="128" Height="14" CornerRadius="7" Background="{DynamicResource SkeletonBrush}" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,20,0,0" Width="580" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,14,0,0" Width="480" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,14,0,0" Width="620" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Border Width="112" Height="14" CornerRadius="7" Background="{DynamicResource SkeletonBrush}" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,20,0,0" Width="540" HorizontalAlignment="Left"/>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource SkeletonBrush}" Margin="0,14,0,0" Width="460" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 数据区 -->
            <ItemsControl ItemsSource="{Binding Sections}"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding IconData}" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,14"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"

                                                           TextWrapping="Wrap" LineHeight="20"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 错误提示 -->
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource DangerTintBrush}" CornerRadius="12" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource AlertIcon}" Width="16" Height="16" Stretch="Uniform"
                          Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5"/>
                    <TextBlock Text="读取系统信息失败，请查看日志后重试。" Margin="10,0,0,0"
                               Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
