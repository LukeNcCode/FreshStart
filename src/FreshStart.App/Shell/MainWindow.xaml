<Window x:Class="FreshStart.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:FreshStart.App.Shell"
        xmlns:controls="clr-namespace:FreshStart.App.Controls"
        Title="FreshStart" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        Icon="pack://application:,,,/FreshStart.Host;component/Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="13" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" CornerRadius="13" BorderThickness="1"
            BorderBrush="{DynamicResource DividerBrush}"
            Background="{DynamicResource WindowBrush}" ClipToBounds="True">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 深墨色控制台导航 -->
        <Border x:Name="SidebarRoot" Grid.Column="0" Grid.RowSpan="2" Width="248"
                Background="{DynamicResource SidebarTintBrush}" ClipToBounds="True"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0"
                MouseLeftButtonDown="Background_MouseLeftButtonDown">
            <shell:Sidebar x:Name="SidebarControl" />
        </Border>

        <!-- 内容区 -->
        <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource WindowBrush}"
                ClipToBounds="True"
                MouseLeftButtonDown="Background_MouseLeftButtonDown">
            <shell:PageHost x:Name="PageHostControl" Margin="0,18,0,0" />
        </Border>

        <!-- 顶栏：页面标识、权限状态和系统窗控 -->
        <Grid x:Name="TitleBar" Grid.Column="1" Grid.Row="0" Height="72"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="34,0,0,0" IsHitTestVisible="False">
                <Border Width="5" Height="24" CornerRadius="2.5"
                        Background="{DynamicResource AccentGradientBrush}" Margin="0,0,13,0" />
                <StackPanel>
                    <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowText}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TitleText}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Border Padding="9,5" Margin="0,0,8,0" CornerRadius="7"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        ToolTip="{Binding ElevationTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ElevationLabel}" Margin="6,0,0,0"
                                   FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource GhostIconButton}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="{Binding ThemeTooltip}"
                        AutomationProperties.Name="切换主题">
                    <Path Data="{Binding ThemeIconData}" Width="16" Height="16" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button Style="{StaticResource GhostIconButton}" Click="ToggleSidebar_Click"
                        ToolTip="收起 / 展开侧边栏" Margin="4,0,0,0"
                        AutomationProperties.Name="收起或展开侧边栏">
                    <Path x:Name="CollapseGlyph" Data="{StaticResource ChevronLeftIcon}"
                          Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>

                <Border Width="1" Height="22" Margin="8,0"
                        Background="{DynamicResource DividerBrush}" />
                <Button Style="{StaticResource WindowCaptionButton}"
                        Tag="{StaticResource MinGlyphIcon}" ToolTip="最小化"
                        Click="Minimize_Click" AutomationProperties.Name="最小化" />
                <Button x:Name="MaxButton" Style="{StaticResource WindowCaptionButton}"
                        Tag="{StaticResource MaxGlyphIcon}"
                        ToolTip="最大化" Click="Maximize_Click"
                        AutomationProperties.Name="最大化" />
                <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}"
                        Tag="{StaticResource CloseGlyphIcon}"
                        ToolTip="关闭" Click="Close_Click"
                        AutomationProperties.Name="关闭" />
            </StackPanel>
        </Grid>

        <controls:ToastHost x:Name="ToastHostControl" Grid.ColumnSpan="2" Grid.RowSpan="2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,22,20" />

        <controls:ModalHost x:Name="ModalHostControl" Grid.ColumnSpan="2" Grid.RowSpan="2" />

        <!-- 首次启动欢迎层：与主窗口共用同一个 HWND，完成后淡出揭示工作台。 -->
        <Grid x:Name="WelcomeHost" Grid.ColumnSpan="2" Grid.RowSpan="2"
              Panel.ZIndex="100" Visibility="Collapsed" />
    </Grid>
    </Border>
</Window>
