<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题：中性灰阶 + 单一强调蓝（现代极简，纯色） -->
    <Color x:Key="WindowColor">#F4F3EF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardHoverColor">#F8F9FC</Color>
    <Color x:Key="CardBorderColor">#DDE3EA</Color>
    <Color x:Key="DividerColor">#E4E7EC</Color>
    <Color x:Key="PrimaryTextColor">#141922</Color>
    <Color x:Key="SecondaryTextColor">#687284</Color>
    <Color x:Key="AccentColor">#1769FF</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="HoverColor">#0F111827</Color>
    <Color x:Key="SelectedTintColor">#1A1769FF</Color>
    <Color x:Key="AccentTintColor">#121769FF</Color>
    <Color x:Key="SuccessTintColor">#1A16A34A</Color>
    <Color x:Key="WarningTintColor">#1AD97706</Color>
    <Color x:Key="DangerTintColor">#1ADC2626</Color>
    <Color x:Key="SidebarTintColor">#101722</Color>
    <Color x:Key="SkeletonColor">#E9EEF5</Color>
    <Color x:Key="ToggleOffColor">#E4E4E9</Color>
    <Color x:Key="InputColor">#FFFFFF</Color>
    <Color x:Key="ScrimColor">#66000000</Color>
    <Color x:Key="ScrollThumbColor">#33000000</Color>
    <Color x:Key="TitleBarHoverColor">#10111826</Color>

    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F1F0EC" Offset="0" />
        <GradientStop Color="#F8F7F4" Offset="0.52" />
        <GradientStop Color="#F3F4F7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedTintBrush" Color="{StaticResource SelectedTintColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColor}" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
    <SolidColorBrush x:Key="SidebarTintBrush" Color="{StaticResource SidebarTintColor}" />
    <SolidColorBrush x:Key="SidebarPrimaryTextBrush" Color="#F6F8FC" />
    <SolidColorBrush x:Key="SidebarSecondaryTextBrush" Color="#8491A5" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#171F2C" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#14294A" />
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="#75ABFF" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#202A39" />
    <SolidColorBrush x:Key="SidebarInputBrush" Color="#151D29" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#F8F7F4" />
    <SolidColorBrush x:Key="AccentGradientStart" Color="#1769FF" />
    <SolidColorBrush x:Key="AccentGradientEnd" Color="#35C7FF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1769FF" Offset="0" />
        <GradientStop Color="#35C7FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="{StaticResource ToggleOffColor}" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="{StaticResource TitleBarHoverColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#17171B" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#FFFFFF" />
</ResourceDictionary>
