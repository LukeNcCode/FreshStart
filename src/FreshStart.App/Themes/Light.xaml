<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题：冷灰蓝极光 + 半透明玻璃 -->
    <Color x:Key="WindowColor">#EEF2F7</Color>
    <Color x:Key="CardColor">#D9FFFFFF</Color>
    <Color x:Key="CardHoverColor">#F2FFFFFF</Color>
    <Color x:Key="CardBorderColor">#B3FFFFFF</Color>
    <Color x:Key="DividerColor">#2415253F</Color>
    <Color x:Key="PrimaryTextColor">#0B1220</Color>
    <Color x:Key="SecondaryTextColor">#667085</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="HoverColor">#102563EB</Color>
    <Color x:Key="SelectedTintColor">#1F2563EB</Color>
    <Color x:Key="AccentTintColor">#182563EB</Color>
    <Color x:Key="SuccessTintColor">#1A16A34A</Color>
    <Color x:Key="WarningTintColor">#1AD97706</Color>
    <Color x:Key="DangerTintColor">#1ADC2626</Color>
    <Color x:Key="SidebarTintColor">#BFFFFFFF</Color>
    <Color x:Key="SkeletonColor">#DFE7F1</Color>
    <Color x:Key="InputColor">#D9FFFFFF</Color>
    <Color x:Key="ScrimColor">#66000000</Color>
    <Color x:Key="ScrollThumbColor">#4D64748B</Color>
    <Color x:Key="TitleBarHoverColor">#142563EB</Color>

    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EEF3F9" Offset="0" />
        <GradientStop Color="#E4EAF2" Offset="0.55" />
        <GradientStop Color="#F4F7FB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedTintBrush" Color="{StaticResource SelectedTintColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColor}" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
    <SolidColorBrush x:Key="SidebarTintBrush" Color="{StaticResource SidebarTintColor}" />
    <SolidColorBrush x:Key="SidebarPrimaryTextBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SidebarSecondaryTextBrush" Color="#667085" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#8CE8EEF8" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1F2563EB" />
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="SidebarInputBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#99F8FAFC" />
    <SolidColorBrush x:Key="AccentGradientStart" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentGradientEnd" Color="#22D3EE" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="IconSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#E2E8F0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="{StaticResource TitleBarHoverColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#17171B" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#FFFFFF" />
</ResourceDictionary>
