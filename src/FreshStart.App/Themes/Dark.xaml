<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题：同一组语义键，现代极简纯色 -->
    <Color x:Key="WindowColor">#090C12</Color>
    <Color x:Key="CardColor">#111720</Color>
    <Color x:Key="CardHoverColor">#17202C</Color>
    <Color x:Key="CardBorderColor">#26303E</Color>
    <Color x:Key="DividerColor">#222B37</Color>
    <Color x:Key="PrimaryTextColor">#F5F7FA</Color>
    <Color x:Key="SecondaryTextColor">#8E9AAC</Color>
    <Color x:Key="AccentColor">#4F8DFF</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="HoverColor">#14FFFFFF</Color>
    <Color x:Key="SelectedTintColor">#265A5A5A</Color>
    <Color x:Key="AccentTintColor">#265A5A5A</Color>
    <Color x:Key="SuccessTintColor">#2634D399</Color>
    <Color x:Key="WarningTintColor">#26FBBF24</Color>
    <Color x:Key="DangerTintColor">#26F87171</Color>
    <Color x:Key="SidebarTintColor">#F6F5F1</Color>
    <Color x:Key="SkeletonColor">#2B2B31</Color>
    <Color x:Key="ToggleOffColor">#3A3A42</Color>
    <Color x:Key="InputColor">#121922</Color>
    <Color x:Key="ScrimColor">#99000000</Color>
    <Color x:Key="ScrollThumbColor">#40FFFFFF</Color>
    <Color x:Key="TitleBarHoverColor">#14FFFFFF</Color>

    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#080B10" Offset="0" />
        <GradientStop Color="#0D121A" Offset="0.58" />
        <GradientStop Color="#080B10" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedTintBrush" Color="{StaticResource SelectedTintColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColor}" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
    <SolidColorBrush x:Key="SidebarTintBrush" Color="{StaticResource SidebarTintColor}" />
    <SolidColorBrush x:Key="SidebarPrimaryTextBrush" Color="#111111" />
    <SolidColorBrush x:Key="SidebarSecondaryTextBrush" Color="#6E6E6A" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#ECEBE6" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#111111" />
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#DEDDD7" />
    <SolidColorBrush x:Key="SidebarInputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#090D13" />
    <SolidColorBrush x:Key="AccentGradientStart" Color="#4F8DFF" />
    <SolidColorBrush x:Key="AccentGradientEnd" Color="#36D6FF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F8DFF" Offset="0" />
        <GradientStop Color="#36D6FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="{StaticResource ToggleOffColor}" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="{StaticResource TitleBarHoverColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#F4F4F7" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#17171B" />
</ResourceDictionary>
