<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题：深海蓝黑极光 + 半透明玻璃 -->
    <Color x:Key="WindowColor">#07111F</Color>
    <Color x:Key="CardColor">#CC101A2A</Color>
    <Color x:Key="CardHoverColor">#E6162235</Color>
    <Color x:Key="CardBorderColor">#2EFFFFFF</Color>
    <Color x:Key="DividerColor">#24FFFFFF</Color>
    <Color x:Key="PrimaryTextColor">#F8FAFC</Color>
    <Color x:Key="SecondaryTextColor">#94A3B8</Color>
    <Color x:Key="AccentColor">#38BDF8</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="HoverColor">#1838BDF8</Color>
    <Color x:Key="SelectedTintColor">#2938BDF8</Color>
    <Color x:Key="AccentTintColor">#2238BDF8</Color>
    <Color x:Key="SuccessTintColor">#2634D399</Color>
    <Color x:Key="WarningTintColor">#26FBBF24</Color>
    <Color x:Key="DangerTintColor">#26F87171</Color>
    <Color x:Key="SidebarTintColor">#B20A1424</Color>
    <Color x:Key="SkeletonColor">#172337</Color>
    <Color x:Key="InputColor">#B20F1A2B</Color>
    <Color x:Key="ScrimColor">#99000000</Color>
    <Color x:Key="ScrollThumbColor">#4D94A3B8</Color>
    <Color x:Key="TitleBarHoverColor">#1838BDF8</Color>

    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#07111F" Offset="0" />
        <GradientStop Color="#0C1728" Offset="0.58" />
        <GradientStop Color="#07111F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedTintBrush" Color="{StaticResource SelectedTintColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColor}" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
    <SolidColorBrush x:Key="SidebarTintBrush" Color="{StaticResource SidebarTintColor}" />
    <SolidColorBrush x:Key="SidebarPrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SidebarSecondaryTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2938BDF8" />
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SidebarInputBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#990A1524" />
    <SolidColorBrush x:Key="AccentGradientStart" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentGradientEnd" Color="#2563EB" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0" />
        <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="IconSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="{StaticResource TitleBarHoverColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#F4F4F7" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#17171B" />
</ResourceDictionary>
