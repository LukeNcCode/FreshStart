<Window x:Class="FreshStart.App.Startup.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 FreshStart"
        Icon="pack://application:,,,/FreshStart.Host;component/Assets/app.ico"
        Width="760" Height="560"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ShowInTaskbar="True">
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="44" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="欢迎使用 FreshStart" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
                <Button Content="✕" Width="36" Height="28" HorizontalAlignment="Right" Margin="0,0,10,0"
                        Style="{StaticResource GhostIconButton}" Click="Exit_Click"
                        AutomationProperties.Name="关闭" />
            </Grid>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="30,4,30,10">

                    <!-- 第 1 步：这是什么 / 怎么用 -->
                    <StackPanel x:Name="Page1">
                        <TextBlock Text="三步把刚装好的系统调顺手" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="FreshStart 是一个面向全新 Windows 11 的开荒工具：改设置、装常用软件、清理垃圾，全部在本机完成，不采集也不上传任何数据。"
                                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="1 · 左侧导航" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="「开荒工作台」是首页；「常用」放了你最可能用到的三项；其余按 优化 / 应用 / 工具 分组。右侧看到「⚠ 计划第 N 批交付」的条目表示功能未完成。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="2 · 每个写入都会先备份" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="点任何开关都会先弹确认（列出改什么、从什么改成什么），确认后先存 JSON 快照再写入；写入失败会自动回滚。「操作历史」页可以对任意一条历史做回滚。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="3 · 推荐的开荒顺序" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="① 「一键开荒」选一套预设 → ② 「推荐软件」补齐 7 个常用软件（解压、浏览器、Everything、PotPlayer、OBS）→ ③ 「系统清理」清缓存 → ④ 需要时用「全局还原」回到首次基准。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 第 2 步：风险须知 -->
                    <StackPanel x:Name="Page2" Visibility="Collapsed">
                        <TextBlock Text="先看清这些风险" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="大部分操作可以回滚，但下面几类不行。动手前请确认你接受后果。"
                                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="不可回滚的操作" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Text="• 彻底移除 Defender 引擎（会删服务/驱动/安全中心，必须重启，可能导致 WSL2、Hyper-V、沙盒不可用）&#10;• Appx 强制卸载（如 Windows 安全中心）&#10;• 软件卸载 / 批量 winget 安装（只做「成功保留 + 失败重试」，不会还原）"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="三条建议" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="① 第一次用请先在虚拟机或全新系统上试；&#10;② 首次写入时选「启用并继续」，让高风险操作自动创建系统还原点；&#10;③ 装了 360 / 火绒等安全软件时，注册表与服务修改可能被拦截——失败属正常，日志里有具体原因。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="数据与联网" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="不采集、不上传任何数据。联网只发生在你主动触发时：软件安装（winget / 官方直链）、Ping、局域网互传。局域网互传是明文 HTTP，只在可信网络使用。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 第 3 步：环境体检 -->
                    <StackPanel x:Name="Page3" Visibility="Collapsed">
                        <TextBlock Text="开始之前，先确认环境" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="下面是自动检测的结果。有异常项不影响浏览，但对应功能可能失败。"
                                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="管理员权限" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="AdministratorText" HorizontalAlignment="Right" FontSize="11.5" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,8" />
                                <Grid>
                                    <TextBlock Text="winget" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="WingetText" HorizontalAlignment="Right" FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,8" />
                                <Grid>
                                    <TextBlock Text="备份目录" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="BackupText" FontSize="10.5" VerticalAlignment="Center"
                                                   MaxWidth="360" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <Button Content="打开" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                Click="OpenBackup_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="随时可以重看" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="这份引导可以在「设置」页重新打开；每个页面的说明文字也会解释该页在做什么。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 底部导航 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="30,12,30,14">
                    <TextBlock x:Name="PageIndex" Text="1 / 3" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" Content="上一步" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="Back_Click" Visibility="Collapsed" />
                        <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}"
                                MinWidth="110" Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
