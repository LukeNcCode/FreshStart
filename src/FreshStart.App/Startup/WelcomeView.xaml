<UserControl x:Class="FreshStart.App.Startup.WelcomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{StaticResource AppFont}"
        Focusable="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="LayoutRoot" Opacity="0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="0.99" ScaleY="0.99" />
                <TranslateTransform x:Name="RootTranslate" Y="8" />
            </TransformGroup>
        </Grid.RenderTransform>
    <Border CornerRadius="13" BorderThickness="1"
            BorderBrush="{DynamicResource DividerBrush}"
            Background="{DynamicResource WindowBrush}"
            ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="318" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 深色品牌区 -->
            <Border Grid.Column="0" Background="{DynamicResource HeroSurfaceBrush}"
                    BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="0,0,1,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid ClipToBounds="True">
                    <Ellipse x:Name="HeroOrb1" Width="420" Height="420" Stroke="#18FFFFFF" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-210,-240,0" />
                    <Ellipse x:Name="HeroOrb2" Width="250" Height="250" Stroke="#14FFFFFF" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-92,-56,0" />
                    <Ellipse Width="310" Height="310" Fill="#0E35C7FF"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-190,0,0,-180" />

                    <Grid Margin="28,26,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="15"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <Grid>
                                    <Border Width="23" Height="3.5" CornerRadius="2"
                                            Background="White" HorizontalAlignment="Left"
                                            VerticalAlignment="Top" Margin="12,14,0,0" />
                                    <Border Width="15" Height="3.5" CornerRadius="2"
                                            Background="#CFFFFFFF" HorizontalAlignment="Left"
                                            VerticalAlignment="Top" Margin="12,23,0,0" />
                                    <Ellipse Width="6" Height="6" Fill="White"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,10,10" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="13,2,0,0">
                                <TextBlock Text="FreshStart" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource HeroTextBrush}" />
                                <TextBlock Text="CONTROL DECK · WINDOWS 11"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="9"
                                           FontWeight="SemiBold" Margin="0,3,0,0"
                                           Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,34,0,0">
                            <TextBlock Text="FIRST RUN / WELCOME" Style="{StaticResource EyebrowText}"
                                       Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                            <TextBlock Text="欢迎使用&#10;FreshStart" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="38" FontWeight="Bold" LineHeight="42"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource HeroTextBrush}" />
                            <TextBlock Text="把新系统调到顺手、干净、可回滚的状态。所有操作都在本机完成。"
                                       FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                       Margin="0,13,0,0" MaxWidth="245"
                                       Foreground="{DynamicResource HeroMutedTextBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,27,0,0">
                            <Border x:Name="StepPill1" CornerRadius="10" Padding="12,10"
                                    Background="#12FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StepDot1" Width="26" Height="26" CornerRadius="8"
                                            Background="{DynamicResource AccentGradientBrush}">
                                        <TextBlock x:Name="StepNumber1" Text="01" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                        <TextBlock x:Name="StepTitle1" Text="认识工作台" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeroTextBrush}" />
                                        <TextBlock Text="导航、能力与开荒顺序" FontSize="9.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource HeroMutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="StepPill2" CornerRadius="10" Padding="12,10" Margin="0,7,0,0"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StepDot2" Width="26" Height="26" CornerRadius="8"
                                            Background="#18FFFFFF">
                                        <TextBlock x:Name="StepNumber2" Text="02" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9" Foreground="{DynamicResource HeroMutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                        <TextBlock x:Name="StepTitle2" Text="安全边界" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeroMutedTextBrush}" />
                                        <TextBlock Text="快照、回滚与不可撤销项" FontSize="9.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource HeroMutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="StepPill3" CornerRadius="10" Padding="12,10" Margin="0,7,0,0"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StepDot3" Width="26" Height="26" CornerRadius="8"
                                            Background="#18FFFFFF">
                                        <TextBlock x:Name="StepNumber3" Text="03" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9" Foreground="{DynamicResource HeroMutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                        <TextBlock x:Name="StepTitle3" Text="环境状态" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeroMutedTextBrush}" />
                                        <TextBlock Text="权限、winget 与备份目录" FontSize="9.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource HeroMutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SidebarSelectedTextBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="本地运行 · 支持回滚 · 不上传数据"
                                           FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HeroTextBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="VersionText" Text="v0.2.0"
                                       FontSize="10" Margin="14,5,0,0"
                                       Foreground="{DynamicResource HeroMutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border Background="{DynamicResource TitleBarBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock Text="FIRST START" Style="{StaticResource EyebrowText}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="14" Margin="10,0" Background="{DynamicResource DividerBrush}" />
                        <TextBlock Text="欢迎引导" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource WindowCloseButton}"
                            Tag="{StaticResource CloseGlyphIcon}"
                            HorizontalAlignment="Right" Margin="0,10,10,0"
                            Click="Exit_Click" AutomationProperties.Name="关闭欢迎引导" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="34,28,34,18" MaxWidth="1040"
                          HorizontalAlignment="Center">
                        <!-- 第 1 步 -->
                        <StackPanel x:Name="Page1">
                            <TextBlock Text="你的 Windows，从这里开始" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="FreshStart 把分散在控制面板、注册表和命令行里的常用操作收进一个可控工作台。先认识它，再开始调整。"
                                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                       Margin="0,7,0,0" LineHeight="20" />

                            <Border CornerRadius="18" Padding="20,18" Margin="0,20,0,0"
                                    Background="{DynamicResource HeroSurfaceBrush}"
                                    BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="LOCAL · REVERSIBLE · AUDITABLE"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                                        <TextBlock Text="开荒，不必靠记忆和运气"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                   FontWeight="Bold" Margin="0,7,0,0"
                                                   Foreground="{DynamicResource HeroTextBrush}" />
                                        <TextBlock Text="所有写操作先读取当前值、创建快照，再写入并校验；失败时自动回滚。"
                                                   FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                                   MaxWidth="410" Margin="0,7,0,0"
                                                   Foreground="{DynamicResource HeroMutedTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="78" Height="78" CornerRadius="39"
                                            Background="{DynamicResource AccentGradientBrush}"
                                            VerticalAlignment="Center" Margin="18,0,0,0">
                                        <Path Data="{StaticResource ShieldIcon}" Width="34" Height="34"
                                              Stretch="Uniform" Stroke="White" StrokeThickness="1.6" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                                    <StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="9"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentTintBrush}">
                                            <Path Data="{StaticResource SparkIcon}" Width="16" Height="16"
                                                  Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.5" />
                                        </Border>
                                        <TextBlock Text="开荒与维护" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,10,0,0" />
                                        <TextBlock Text="预设、隐私、界面、服务与 Windows 更新"
                                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14">
                                    <StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="9"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentTintBrush}">
                                            <Path Data="{StaticResource RefreshIcon}" Width="16" Height="16"
                                                  Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.5" />
                                        </Border>
                                        <TextBlock Text="环境克隆" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,10,0,0" />
                                        <TextBlock Text="聊天数据与开发环境离线迁移到新系统"
                                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Padding="16,13" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{DynamicResource SuccessTintBrush}">
                                        <Path Data="{StaticResource CheckIcon}" Width="15" Height="15"
                                              Stretch="Uniform" Stroke="{DynamicResource SuccessBrush}"
                                              StrokeThickness="1.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="建议顺序" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="先看风险，再检查环境；之后从开荒工作台和一键开荒开始。"
                                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 第 2 步 -->
                        <StackPanel x:Name="Page2" Visibility="Collapsed">
                            <TextBlock Text="先看清安全边界" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="大多数系统写入都可以回滚，但清理、卸载和部分安全组件操作本身不可撤销。"
                                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                       Margin="0,7,0,0" LineHeight="20" />

                            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0"
                                    Background="{DynamicResource WarningTintBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource WarningTintBrush}">
                                        <Path Data="{StaticResource AlertIcon}" Width="17" Height="17"
                                              Stretch="Uniform" Stroke="{DynamicResource WarningBrush}"
                                              StrokeThickness="1.6" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="不可回滚操作会明确标注" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                        <TextBlock Text="涉及 Defender 引擎移除、Appx 强制卸载、软件卸载与系统清理时，页面会在执行前说明后果。"
                                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="写入管线" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="读取 → 快照 → 写入 → 校验 → 失败回滚"
                                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="本地优先" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="不采集、不上传；只有你主动安装、测速或互传时才会联网。"
                                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="首次使用建议" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="先为重要数据留独立备份；第一次执行高风险操作时，让 FreshStart 创建系统还原点；安全软件拦截时查看日志，不要连续重复尝试。"
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                               Margin="0,6,0,0" LineHeight="18" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 第 3 步 -->
                        <StackPanel x:Name="Page3" Visibility="Collapsed">
                            <TextBlock Text="环境检查完成" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="这里只展示启动时已经读取到的状态。异常项不会阻止浏览，但对应功能可能提示失败。"
                                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                       Margin="0,7,0,0" LineHeight="20" />

                            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ShieldIcon}" Width="15" Height="15"
                                                  Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.5" />
                                            <TextBlock Text="管理员权限" FontSize="12.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="AdministratorText" Grid.Column="1"
                                                   FontSize="11.5" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Grid Margin="0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource RefreshIcon}" Width="15" Height="15"
                                                  Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.5" />
                                            <TextBlock Text="winget" FontSize="12.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="WingetText" Grid.Column="1" FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource FolderIcon}" Width="15" Height="15"
                                                  Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.5" />
                                            <TextBlock Text="备份目录" FontSize="12.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock x:Name="BackupText" FontSize="10.5"
                                                       VerticalAlignment="Center" MaxWidth="250"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <Button Content="打开" Style="{StaticResource SmallButton}"
                                                    Margin="8,0,0,0" Click="OpenBackup_Click" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="18" Padding="20,18" Margin="0,14,0,0"
                                    Background="{DynamicResource HeroSurfaceBrush}"
                                    BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="READY TO START" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                                        <TextBlock Text="现在可以开始探索 FreshStart"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                                   FontWeight="Bold" Margin="0,7,0,0"
                                                   Foreground="{DynamicResource HeroTextBrush}" />
                                        <TextBlock Text="从开荒工作台开始，或直接使用一键开荒与推荐软件。"
                                                   FontSize="11.5" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource HeroMutedTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="58" Height="58" CornerRadius="29"
                                            Background="{DynamicResource AccentGradientBrush}"
                                            VerticalAlignment="Center" Margin="18,0,0,0">
                                        <Path Data="{StaticResource CheckIcon}" Width="25" Height="25"
                                              Stretch="Uniform" Stroke="White" StrokeThickness="2" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0" Background="{DynamicResource TitleBarBrush}">
                    <Grid Margin="30,13,30,15">
                        <TextBlock x:Name="PageIndex" Text="1 / 3" FontSize="10.5"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="跳过" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0" Click="Exit_Click" />
                            <Button x:Name="BackButton" Content="上一步"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0" Click="Back_Click"
                                    Visibility="Collapsed" />
                            <Button x:Name="NextButton" Content="下一步"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="116" Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
