<Window x:Class="FreshStart.App.Startup.WingetUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="可选 winget 更新"
        Width="560" Height="390"
        Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="4" Height="18" CornerRadius="2"
                            Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="OPTIONAL UPDATE" Style="{StaticResource EyebrowText}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}"
                        Tag="{StaticResource CloseGlyphIcon}"
                        HorizontalAlignment="Right" Margin="0,9,10,0"
                        Click="Later_Click" AutomationProperties.Name="稍后更新" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="26,22,26,24">
                <TextBlock Text="更新 winget 离线组件" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap" Margin="0,7,0,0" />

                <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,18,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,1,0,0" />
                        </Grid>
                        <ProgressBar Height="5" Minimum="0" Maximum="100" Margin="0,12,0,0"
                                     IsIndeterminate="{Binding IsBusy}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="更新只使用安装包内的 Microsoft 官方离线文件，不会联网下载。你也可以稍后在「推荐软件」中手动处理。"
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,14,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="稍后" Style="{StaticResource SecondaryButton}"
                            Click="Later_Click" MinWidth="82" />
                    <Button Content="{Binding ActionText}" Style="{StaticResource PrimaryButton}"
                            Click="Install_Click" IsEnabled="{Binding CanInstall}"
                            MinWidth="132" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
