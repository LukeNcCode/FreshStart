<Window x:Class="FreshStart.App.Controls.ActivityConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreshStart Task Events"
        Width="680" Height="380" MinWidth="480" MinHeight="260"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="Transparent" Foreground="#ece9df"
        FontFamily="Cascadia Code, Consolas, monospace"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="pack://application:,,,/FreshStart.Host;component/Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                      GlassFrameThickness="0" CornerRadius="14"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14" BorderBrush="#42433a" BorderThickness="1"
            Background="#1b1c18" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#20211c"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border Width="46" Height="3" CornerRadius="2" Background="#42433a"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Content="−" Click="Minimize_Click"
                            Width="32" Height="28" Background="Transparent"
                            BorderThickness="0" Foreground="#8f9085" FontSize="15"
                            ToolTip="最小化"/>
                    <Button Content="×" Click="Close_Click"
                            Width="34" Height="28" Background="Transparent"
                            BorderThickness="0" Foreground="#a7a69b" FontSize="15"
                            ToolTip="关闭控制台"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="LogScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="17,13">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" FontSize="10.5"
                                       LineHeight="18" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="#c8c6bc"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="Muted">
                                                <Setter Property="Foreground" Value="#8f9085"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="Error">
                                                <Setter Property="Foreground" Value="#ef927f"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding Time}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Message}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
